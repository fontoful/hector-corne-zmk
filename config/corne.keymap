#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    combos {
        compatible = "zmk,combos";

        right-hand-jkl-right-gui {
            bindings = <&kp RIGHT_GUI>;
            key-positions = <19 20 21>;
            timeout-ms = <30>;
            layers = <0>;
        };

        both-shifts-caps-lock {
            bindings = <&kp CAPS>;
            key-positions = <24 35>;
            layers = <0>;
            timeout-ms = <30>;
        };
    };

    macros {
        spanish_tilde: spanish_tilde {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp RIGHT_ALT>,
                <&macro_tap>,
                <&kp E>,
                <&macro_release>,
                <&kp RIGHT_ALT>;

            label = "SPANISH_TILDE";
        };

        exclamation_mark: exclamation_mark {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp RIGHT_ALT>,
                <&macro_tap>,
                <&kp NUMBER_1>,
                <&macro_release>,
                <&kp RIGHT_ALT>;

            label = "EXCLAMATION_MARK";
        };

        opening_question_mark: opening_question_mark {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_ALT &kp LEFT_SHIFT>,
                <&macro_tap>,
                <&kp SLASH>,
                <&macro_release>,
                <&kp LEFT_ALT &kp LEFT_SHIFT>;

            label = "OPENING_QUESTION_MARK";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BKSP |
            // | CTRL |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   |
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | ESC  |
            //                    | GUI | LWR | SPC |   | ENT | RSE  | ALT |

            display-name = "Base";
            bindings = <
&kp TAB           &kp Q  &kp W  &kp E  &kp R  &kp T    &kp Y      &kp U          &kp I      &kp O    &kp P     &kp ESCAPE
&kp LEFT_COMMAND  &kp A  &kp S  &kp D  &kp F  &kp G    &kp H      &kp J          &kp K      &kp L    &kp SEMI  &kp SQT
&kp LSHFT         &kp Z  &kp X  &kp C  &kp V  &kp B    &kp N      &kp M          &kp COMMA  &kp DOT  &kp FSLH  &kp RIGHT_SHIFT
                                &mo 5  &mo 1  &mo 4    &kp SPACE  &kp BACKSPACE  &mo 2
            >;
        };

        lower_layer {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  | BKSP |
            // | BTCLR| BT1 | BT2 | BT3 | BT4 | BT5 |   | LFT | DWN |  UP | RGT |     |      |
            // | SHFT |     |     |     |     |     |   |     |     |     |     |     |      |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            display-name = "Lower";
            bindings = <
&kp TAB  &kp LS(NUMBER_1)  &kp LS(NUMBER_2)  &kp LS(NUMBER_3)  &kp RS(NUMBER_4)  &kp LS(N5)      &kp LS(NUMBER_6)  &kp LS(N7)     &kp LS(NUMBER_8)  &kp LS(NUMBER_9)      &kp LS(NUMBER_0)       &kp NON_US_BACKSLASH
&trans   &kp LEFT_GUI      &kp LEFT_ALT      &kp LEFT_CONTROL  &kp LEFT_SHIFT    &bt BT_SEL 4    &kp MINUS         &kp EQUAL      &kp GRAVE         &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &kp RS(NON_US_BACKSLASH)
&trans   &trans            &trans            &bt BT_PRV        &bt BT_NXT        &trans          &kp LS(MINUS)     &kp LS(EQUAL)  &kp LS(GRAVE)     &kp LS(LEFT_BRACKET)  &kp LS(RIGHT_BRACKET)  &trans
                                             &trans            &trans            &trans          &trans            &kp BACKSPACE  &mo 3
            >;
        };

        raise_layer {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  | BKSP |
            // | CTRL |     |     |     |     |     |   |  -  |  =  |  [  |  ]  |  \  |  `   |
            // | SHFT |     |     |     |     |     |   |  _  |  +  |  {  |  }  | "|" |  ~   |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            display-name = "Raise";
            bindings = <
&kp F1     &kp F2          &kp F3      &kp F4             &kp F5           &kp F6                  &kp F7          &kp F8          &kp F9        &kp F10          &kp F11  &kp F12
&kp RGUI   &kp RGUI        &kp LALT    &kp LCTRL          &kp LSHFT        &kp RGUI                &kp LEFT_ARROW  &kp DOWN_ARROW  &kp UP_ARROW  &kp RIGHT_ARROW  &trans   &trans
&kp LSHFT  &kp C_PREVIOUS  &kp C_NEXT  &kp C_VOLUME_DOWN  &kp C_VOLUME_UP  &kp RG(K_PLAY_PAUSE)    &trans          &trans          &trans        &trans           &trans   &trans
                                       &trans             &trans           &trans                  &trans          &trans          &trans
            >;
        };

        layer_3 {
            bindings = <
&trans  &trans    &trans    &trans     &trans     &trans       &trans  &kp N7         &kp N8           &kp N9  &trans  &trans
&trans  &kp LGUI  &kp LALT  &kp LCTRL  &kp LSHFT  &trans       &trans  &kp N4         &kp N5           &kp N6  &trans  &trans
&trans  &trans    &trans    &trans     &trans     &kp ENTER    &trans  &kp N1         &kp N2           &kp N3  &trans  &trans
                            &trans     &trans     &trans       &trans  &kp BACKSPACE  &kp KP_NUMBER_0
            >;
        };

        layer_4 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans    &trans  &trans  &trans
            >;
        };

        layer_5 {
            bindings = <
&trans  &trans        &trans        &trans            &trans          &trans    &trans  &trans             &trans             &trans         &trans         &trans
&trans  &kp LEFT_GUI  &kp LEFT_ALT  &kp LEFT_CONTROL  &kp LEFT_SHIFT  &trans    &trans  &kp RIGHT_SHIFT    &kp RIGHT_CONTROL  &kp RIGHT_ALT  &kp RIGHT_GUI  &trans
&trans  &trans        &trans        &trans            &trans          &trans    &trans  &exclamation_mark  &spanish_tilde     &trans         &trans         &trans
                                    &trans            &trans          &trans    &trans  &trans             &trans
            >;
        };
    };
};
